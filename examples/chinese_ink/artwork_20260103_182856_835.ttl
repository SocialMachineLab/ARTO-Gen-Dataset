:artwork_20260103_182856_835_scene_obj_0 rdf:type arto:Object , owl:NamedIndividual , :Bird ;
    rdfs:label "Swallow"@en ;
    arto:cocoCategory "bird" ;
    arto:hasSize :MediumSize ;
    dcterms:description "Graceful bird rendered in fluid black ink strokes, its form captured in mid-flight with elegant sweeping lines that suggest motion. The cloudy morning light softens the plumage, creating subtle gradations from deep charcoal to soft gray washes. Its forked tail trails like brush calligraphy, while the white underbelly appears as delicate negative space against the misty atmosphere. The feathers are suggested through minimal, confident strokes that capture the bird's energetic yet gentle presence in the cool, subdued light."@en ;
    arto:state [ a skos:Concept ; rdfs:label "In active flight, wings spread in dynamic arc, pristine and vital"@en ] ;

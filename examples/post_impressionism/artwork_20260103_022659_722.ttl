:artwork_20260103_022659_722_scene_obj_0 rdf:type arto:Object , owl:NamedIndividual , :Bird ;
    rdfs:label "Hen"@en ;
    arto:cocoCategory "bird" ;
    arto:hasSize :MediumSize ;
    dcterms:description "A plump hen with feathers rendered in bold, textured strokes of warm ochre and russet brown, catching the morning light streaming through the market's open windows. Her plumage shows subtle iridescent highlights where sunlight strikes, with deep shadows in cobalt-tinged blues beneath her wings. The beak gleams with a sharp yellow-orange accent, while her eye is a dark, intense bead of obsidian. The overall effect is one of vibrant, energetic presence with visible brushwork suggesting movement and life."@en ;
    arto:state [ a skos:Concept ; rdfs:label "Alert and active, feathers fluffed with morning vitality"@en ] ;
    arto:hasCoordinates [
        a qudt:Vector ;
        qudt:vector (111.31584167480469 500.28387451171875 456.36248779296875 986.9457397460938)
    ] .

:artwork_20260103_022659_722_scene arto:containsObject :artwork_20260103_022659_722_scene_obj_0 .

:artwork_20260103_022659_722_scene_obj_1 rdf:type arto:Object , owl:NamedIndividual , :HorseCart ;
    rdfs:label "Horse Cart"@en ;
    arto:cocoCategory "car" ;
    arto:hasSize :LargeSize ;
    dcterms:description "A sturdy wooden cart with weathered planks painted in Post-Impressionist blocks of sienna and burnt umber, their grain visible through thick, directional brushstrokes. The wooden frame shows a patina of age with silvery-gray weathering where the morning sun creates sharp, angular shadows. Metal hardware and iron rims on the wheels catch the light with bold, unmodulated strokes of metallic gray and white, creating stark contrasts against the darker wood. The overall appearance is robust and functional, with visible texture and material character."@en ;
    arto:material [ a arto:MaterialType ; rdfs:label "wood"@en ; skos:exactMatch aat:300011914 ] ;
    arto:material [ a arto:MaterialType ; rdfs:label "iron"@en ; skos:exactMatch aat:300011002 ] ;
    arto:state [ a skos:Concept ; rdfs:label "Well-used but sturdy, showing practical wear from contemporary rural use"@en ] ;
    arto:hasCoordinates [
        a qudt:Vector ;
        qudt:vector (389.8337707519531 73.1251220703125 1009.3663330078125 579.2325439453125)
    ] .

:artwork_20260103_022659_722_scene arto:containsObject :artwork_20260103_022659_722_scene_obj_1 .

:artwork_20260103_022659_722_scene_obj_2 rdf:type arto:Object , owl:NamedIndividual , :Chair ;
    rdfs:label "Stand"@en ;
    arto:cocoCategory "chair" ;
    arto:hasSize :MediumSize ;
    dcterms:description "A simple wooden display stand with shelves showing the natural grain through patches of faded blue paint, applied with confident, visible strokes. The morning light creates strong geometric shadows across its surfaces, highlighting the angular construction. The wood shows warm honey tones where sunlight directly strikes, while recessed areas take on cooler violet-gray shadows. The shelves display subtle dust motes dancing in the sunbeams, captured as flecks of pure white and yellow in the paint application."@en ;
    arto:material [ a arto:MaterialType ; rdfs:label "wood"@en ; skos:exactMatch aat:300011914 ] ;
    arto:state [ a skos:Concept ; rdfs:label "Functional and weathered, with chipped paint revealing the natural wood beneath"@en ] ;
    arto:hasCoordinates [
        a qudt:Vector ;
        qudt:vector (473.9615478515625 553.8565673828125 1023.6468505859375 1022.638671875)
    ] .

:artwork_20260103_022659_722_scene arto:containsObject :artwork_20260103_022659_722_scene_obj_2 .

:artwork_20260103_022659_722_scene_obj_3 rdf:type arto:Object , owl:NamedIndividual , :PottedPlant ;
    rdfs:label "Rose"@en ;
    arto:cocoCategory "potted plant" ;
    arto:hasSize :SmallSize ;
    dcterms:description "A single crimson rose rendered with passionate, thick impasto strokes of deep scarlet and magenta, its petals catching the morning light with brilliant highlights of pure vermilion and orange. The petals appear velvety and lush, with visible texture from the sculptural paint application. Small thorns are suggested by sharp dabs of olive green and brown. The stem shows as vibrant emerald green with strokes of lime for the fresh morning vitality. The flower glows with an inner luminosity against the indoor shadows, a jewel-like focal point of saturated color."@en ;
    arto:state [ a skos:Concept ; rdfs:label "Fresh and vibrant, just opened in the morning light"@en ] ;
    arto:hasCoordinates [
        a qudt:Vector ;
        qudt:vector (630.0305786132812 543.5037841796875 745.5908813476562 661.0035400390625)
    ] .


:artwork_20260103_173226_943_scene_obj_4 rdf:type arto:Object , owl:NamedIndividual , :Oven ;
    rdfs:label "Stove"@en ;
    arto:cocoCategory "oven" ;
    arto:hasSize :LargeSize ;
    dcterms:description "A cast iron stove depicted with thick, impasto strokes of charcoal gray and deep slate, its dark surface punctuated by brilliant highlights of pale blue and white where the intense afternoon light strikes its metallic edges. The cool ambient light of the courtyard creates subtle violet and lavender tones within the shadows, contrasting with the warm overall atmosphere. The heavy, textured paint application suggests the stove's substantial weight and industrial character. Visible brushwork captures the interplay between the dark, light-absorbing metal and the scattered, intense reflections that break across its angular surfaces."@en ;
    arto:material [ a arto:MaterialType ; rdfs:label "iron"@en ; skos:exactMatch aat:300011002 ] ;
    arto:state [ a skos:Concept ; rdfs:label "cool-toned metal with intense light reflections"@en ] ;

:artwork_20260103_173226_943_scene_obj_3 rdf:type arto:Object , owl:NamedIndividual , :DiningTable ;
    rdfs:label "Table"@en ;
    arto:cocoCategory "dining table" ;
    arto:hasSize :MediumSize ;
    dcterms:description "A wooden tabletop bathed in brilliant afternoon light, its surface alive with rapid, visible brushstrokes of warm honey, golden ochre, and pale tan. The bright sunlight creates strong, warm reflections that appear almost white in the most illuminated patches. The Impressionist treatment shows the wood grain through loose, directional strokes rather than detailed rendering. Edges soften into the surrounding brightness, and subtle shadows in muted purple and cool gray suggest the table's form. The surface appears dry and matte, absorbing and reflecting light in a way that creates a rich tapestry of warm tones."@en ;
    arto:material [ a arto:MaterialType ; rdfs:label "wood"@en ; skos:exactMatch aat:300011914 ] ;
    arto:state [ a skos:Concept ; rdfs:label "dry and matte, warmly illuminated"@en ] ;
    arto:hasCoordinates [
        a qudt:Vector ;
        qudt:vector (178.615478515625 619.1055908203125 785.2933959960938 1018.4251708984375)
    ] .


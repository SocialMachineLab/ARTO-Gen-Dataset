:artwork_20260103_173226_943_scene_obj_0 rdf:type arto:Object , owl:NamedIndividual , :Umbrella ;
    rdfs:label "Sunshade"@en ;
    arto:cocoCategory "umbrella" ;
    arto:hasSize :LargeSize ;
    dcterms:description "A large canvas canopy rendered in loose, visible brushstrokes of warm cream and pale yellow, catching the brilliant afternoon sunlight that filters through its fabric. The material appears slightly translucent, with dappled light creating soft patches of golden warmth where the sun penetrates. The fabric shows subtle variations in opacity, with thicker paint application suggesting the textured weave. Gentle shadows dance across its surface in muted lavender and soft gray, creating a lively interplay of light and color characteristic of Impressionist technique."@en ;
    arto:material [ a arto:MaterialType ; rdfs:label "canvas"@en ; skos:exactMatch aat:300014078 ] ;
    arto:state [ a skos:Concept ; rdfs:label "partially translucent from bright light exposure"@en ] ;
    arto:hasCoordinates [
        a qudt:Vector ;
        qudt:vector (64.53689575195312 -2.087310791015625 1024.71337890625 340.23052978515625)
    ] .

:artwork_20260103_173226_943_scene arto:containsObject :artwork_20260103_173226_943_scene_obj_0 .

:artwork_20260103_173226_943_scene_obj_1 rdf:type arto:Object , owl:NamedIndividual , :Vase ;
    rdfs:label "Vase"@en ;
    arto:cocoCategory "vase" ;
    arto:hasSize :MediumSize ;
    dcterms:description "A ceramic vessel decorated with bold, gestural strokes of cobalt blue and white, its glossy surface fractured into brilliant highlights where direct sunlight strikes. The glaze reflects the courtyard's brightness with scattered flecks of pure white and pale orange, suggesting the warm ambient light. Quick, confident brushwork captures the vase's curved form, with visible dabs of deeper blue in shadowed areas and soft edges that dissolve into the surrounding atmosphere. The decorative patterns are suggested through loose, impressionistic marks rather than precise detail."@en ;
    arto:material [ a arto:MaterialType ; rdfs:label "ceramic"@en ; skos:exactMatch aat:300235507 ] ;
    arto:state [ a skos:Concept ; rdfs:label "glossy and reflective in bright conditions"@en ] ;
    arto:hasCoordinates [
        a qudt:Vector ;
        qudt:vector (386.223876953125 512.61767578125 496.44073486328125 678.6903076171875)
    ] .


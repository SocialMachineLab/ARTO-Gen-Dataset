:artwork_20260103_173226_943_scene_obj_2 rdf:type arto:Object , owl:NamedIndividual , :LampPost ;
    rdfs:label "Lamp Post"@en ;
    arto:cocoCategory "traffic light" ;
    arto:hasSize :LargeSize ;
    dcterms:description "A metal structure rendered in vertical strokes of weathered bronze and deep umber, its surface warmed by the afternoon sun into subtle copper tones. The metallic finish shows scattered highlights of bright gold where light catches the edges, while shadowed portions fade into cool gray-blue tones. The paint application is varied—thicker on the illuminated surfaces, thinner and more transparent in recessed areas. Though unlit, the fixture retains a suggestion of its industrial character through visible, confident brushwork that captures both its solidity and the way light plays across its cylindrical form."@en ;
    arto:material [ a arto:MaterialType ; rdfs:label "metal"@en ; skos:exactMatch aat:300010900 ] ;
    arto:state [ a skos:Concept ; rdfs:label "weathered but solid, warm-toned in sunlight"@en ] ;
    arto:hasCoordinates [
        a qudt:Vector ;
        qudt:vector (73.71107482910156 18.03021240234375 247.5575408935547 1017.6702270507812)
    ] .


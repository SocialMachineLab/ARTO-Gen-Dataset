:artwork_20260104_013158_608_scene_obj_3 rdf:type arto:Object , owl:NamedIndividual , :Knife ;
    rdfs:label "Dagger"@en ;
    arto:cocoCategory "knife" ;
    arto:hasSize :SmallSize ;
    dcterms:description "A decorative dagger with a polished steel blade and an ornate bronze handle. The blade reflects the gray light from the window in a long, cool, diffuse highlight, its surface too finely etched to be a perfect mirror. The bronze handle has a warm, dark patina that absorbs light, creating a rich contrast against the cool steel. The intricate neoclassical engravings on the hilt are emphasized by the soft shadows cast by the ambient light."@en ;
    arto:material [ a arto:MaterialType ; rdfs:label "steel"@en ; skos:exactMatch aat:300133751 ] ;
    arto:material [ a arto:MaterialType ; rdfs:label "bronze"@en ; skos:exactMatch aat:300010957 ] ;
    arto:state [ a skos:Concept ; rdfs:label "decorative, showing a fine layer of patina on the bronze and a clean, unblemished blade"@en ] ;
    arto:hasCoordinates [
        a qudt:Vector ;
        qudt:vector (232.07449340820312 690.8045654296875 780.7205810546875 915.056640625)

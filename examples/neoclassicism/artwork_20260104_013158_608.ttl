:artwork_20260104_013158_608_scene_obj_2 rdf:type arto:Object , owl:NamedIndividual , :Apple ;
    rdfs:label "Pear"@en ;
    arto:cocoCategory "apple" ;
    arto:hasSize :SmallSize ;
    dcterms:description "A decorative pear sculpture rendered in glazed ceramic. Its surface is smooth and vitreous, catching the flat, diffused light with a gentle, even sheen. The cool tones of the cloudy afternoon are reflected in the glaze, giving the yellow-green surface a muted, sophisticated appearance. The color transitions subtly from a pale chartreuse at the stem to a deeper olive at the base, with the matte finish softening any harsh contrasts."@en ;
    arto:state [ a skos:Concept ; rdfs:label "artistic object, perfectly formed and unblemished"@en ] ;
    arto:hasCoordinates [
        a qudt:Vector ;
        qudt:vector (198.8252410888672 626.07177734375 309.88909912109375 790.523193359375)
    ] .


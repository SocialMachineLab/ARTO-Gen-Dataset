:artwork_20260104_013158_608_scene_obj_1 rdf:type arto:Object , owl:NamedIndividual , :Cup ;
    rdfs:label "Trophy Cup"@en ;
    arto:cocoCategory "cup" ;
    arto:hasSize :MediumSize ;
    dcterms:description "A polished silver trophy cup that gleams with a soft, cool luminance under the overcast light. Its surface acts as a subtle mirror, capturing the muted tones of the surrounding atmosphere rather than bright highlights. The metal shows a slight patina in the crevices of its neoclassical relief work, where shadows pool gently. The cool daylight enhances its metallic sheen, giving it a dignified, almost ethereal glow."@en ;
    arto:material [ a arto:MaterialType ; rdfs:label "silver"@en ; skos:exactMatch aat:300011029 ] ;
    arto:state [ a skos:Concept ; rdfs:label "antique quality with gentle tarnish in recesses, highly polished on prominent surfaces"@en ] ;
    arto:hasCoordinates [
        a qudt:Vector ;
        qudt:vector (354.68487548828125 418.064453125 598.227294921875 761.6746826171875)
    ] .


:artwork_20260104_013158_608_scene_obj_0 rdf:type arto:Object , owl:NamedIndividual , :Bed ;
    rdfs:label "Bed"@en ;
    arto:cocoCategory "bed" ;
    arto:hasSize :DominantSize ;
    dcterms:description "A grand four-poster bed with carved mahogany posts and a richly upholstered headboard in deep burgundy velvet. The afternoon's diffused, cool light from the cloudy sky softly illuminates the carved details, casting gentle shadows that reveal the wood's ornate acanthus leaf motifs. The fabric appears plush and matte, absorbing light rather than reflecting it, with subtle variations in the pile creating a sense of depth and quiet luxury."@en ;
    arto:material [ a arto:MaterialType ; rdfs:label "wood"@en ; skos:exactMatch aat:300011914 ] ;
    arto:material [ a arto:MaterialType ; rdfs:label "velvet"@en ; skos:exactMatch aat:300133711 ] ;
    arto:state [ a skos:Concept ; rdfs:label "pristine and well-maintained, reflecting contemporary care of antique styles"@en ] ;
    arto:hasCoordinates [
        a qudt:Vector ;
        qudt:vector (1.070526123046875 248.4910888671875 1022.6551513671875 1022.2880859375)
    ] .


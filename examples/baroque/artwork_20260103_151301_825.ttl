:artwork_20260103_151301_825_scene_obj_0 rdf:type arto:Object , owl:NamedIndividual , :Fork ;
    rdfs:label "Fork"@en ;
    arto:cocoCategory "fork" ;
    arto:hasSize :SmallSize ;
    dcterms:description "A lustrous silver fork with ornate Baroque scrollwork on the handle, catching brilliant afternoon sunlight streaming through a window. The polished tines gleam with sharp highlights and cast delicate shadows, while the warm natural light brings out subtle engravings with deep contrast. The metal surface reflects golden ambient light from the surrounding space, creating a jewel-like sparkle against the dark pantry background."@en ;
    arto:material [ a arto:MaterialType ; rdfs:label "silver"@en ; skos:exactMatch aat:300011029 ] ;
    arto:state [ a skos:Concept ; rdfs:label "polished and well-maintained, showing signs of careful use appropriate to early modern household"@en ] ;
    arto:hasCoordinates [
        a qudt:Vector ;
        qudt:vector (270.4039306640625 492.498779296875 541.1382446289062 566.435302734375)
    ] .

:artwork_20260103_151301_825_scene arto:containsObject :artwork_20260103_151301_825_scene_obj_0 .

:artwork_20260103_151301_825_scene_obj_1 rdf:type arto:Object , owl:NamedIndividual , :Bottle ;
    rdfs:label "Glass Jar"@en ;
    arto:cocoCategory "bottle" ;
    arto:hasSize :MediumSize ;
    dcterms:description "A thick-walled glass jar filled with preserves, standing in a pool of brilliant afternoon sunlight. The clear glass refracts the bright natural light into prismatic rainbow edges, while the contents glow with deep amber and honey tones. Condensation beads on the cool surface catch the light like scattered diamonds, and the curved glass creates soft, distorted reflections of the bright pantry interior. The cork stopper appears dark and matte against the luminous jar."@en ;
    arto:material [ a arto:MaterialType ; rdfs:label "glass"@en ; skos:exactMatch aat:300010797 ] ;
    arto:state [ a skos:Concept ; rdfs:label "clean and sealed, with moisture droplets from cool contents reacting to warm air"@en ] ;
    arto:hasCoordinates [
        a qudt:Vector ;
        qudt:vector (277.3935546875 550.7973022460938 503.365478515625 885.6171264648438)
    ] .

:artwork_20260103_151301_825_scene arto:containsObject :artwork_20260103_151301_825_scene_obj_1 .

:artwork_20260103_151301_825_scene_obj_2 rdf:type arto:Object , owl:NamedIndividual , :Handbag ;
    rdfs:label "Handbag"@en ;
    arto:cocoCategory "handbag" ;
    arto:hasSize :MediumSize ;
    dcterms:description "A rich leather handbag with embossed Baroque patterns, resting in the bright, cheerful atmosphere. The afternoon sun illuminates the worn leather texture, revealing warm brown tones with golden highlights on raised surfaces. The brass hardware and clasps gleam with polished warmth, while the soft leather absorbs and diffuses the bright light, creating subtle shadows in the tooling. The fabric lining peeks through with faded richness, showing the patina of age and use."@en ;
    arto:material [ a arto:MaterialType ; rdfs:label "leather"@en ; skos:exactMatch aat:300011845 ] ;
    arto:state [ a skos:Concept ; rdfs:label "well-used but cared for, showing elegant wear patterns and rich patina appropriate to early modern craftsmanship"@en ] ;
    arto:hasCoordinates [
        a qudt:Vector ;
        qudt:vector (505.44677734375 354.7198791503906 945.1627197265625 873.498779296875)
    ] .

